{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/testing": "jsr:@std/testing@1",
    "@std/cli": "jsr:@std/cli@1",
    "@std/path": "jsr:@std/path@1",
    "@std/fs": "jsr:@std/fs@1",
    "uuid": "npm:uuid@14",
    "fresh": "jsr:@fresh/core@2",
    "@fresh/core": "jsr:@fresh/core@2",
    "preact": "npm:preact@10",
    "preact/hooks": "npm:preact@10/hooks",
    "@preact/signals": "npm:@preact/signals@2",
    "duckdb": "npm:duckdb@1.4.4"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-env --allow-write --allow-net --allow-run",
    "test:watch": "deno test --watch --allow-read --allow-env --allow-write --allow-net --allow-run",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno check src/**/*.ts",
    "verify": "deno task check && deno task lint && deno task test",
    "review": "deno run -A review/cli.ts"
  },
  "lint": {
    "rules": {
      "exclude": ["require-await", "no-explicit-any"]
    }
  }
}
